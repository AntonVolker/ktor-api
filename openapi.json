{
  "openapi": "3.1.0",
  "info": {
    "title": "Ktor Locations API",
    "version": "1.0.0",
    "description": "REST API for managing locations, parking spaces, and EV charging stations with geospatial search and scope-based authorization."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "security": [
    {
      "bearerAuth": [

      ]
    }
  ],
  "paths": {
    "/test": {
      "get": {
        "summary": "Test endpoint",
        "security": [

        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/locations": {
      "get": {
        "summary": "List all locations",
        "security": [
          {
            "bearerAuth": [
              "locations:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (starts from 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of locations per page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LocationResponse"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/locations/search": {
      "get": {
        "summary": "Geospatial search",
        "description": "Find locations within a specific radius of a coordinate.",
        "security": [
          {
            "bearerAuth": [
              "locations:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "radiusKm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of locations found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LocationResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/locations/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Get a location by ID",
        "security": [
          {
            "bearerAuth": [
              "locations:read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "summary": "Update a location by ID",
        "security": [
          {
            "bearerAuth": [
              "locations:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/LocationUpdateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/ParkingSpaceUpdateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/EvChargingStationUpdateRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LocationResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ParkingSpaceResponse"
                    },
                    {
                      "$ref": "#/components/schemas/EvChargingStationResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "summary": "Delete a location by ID",
        "security": [
          {
            "bearerAuth": [
              "locations:write"
            ]
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/locations/parking": {
      "post": {
        "summary": "Create a parking space location",
        "security": [
          {
            "bearerAuth": [
              "locations:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParkingSpaceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParkingSpaceResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/locations/ev-charging": {
      "post": {
        "summary": "Create an EV charging station location",
        "security": [
          {
            "bearerAuth": [
              "locations:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvChargingStationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvChargingStationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token with 'scope' claim containing 'locations:read' and/or 'locations:write'."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request (validation failed)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized (invalid or missing token)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden (insufficient permissions/scopes)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "LocationType": {
        "type": "string",
        "enum": [
          "PARKING_SPACE",
          "EV_CHARGING_STATION",
          "GENERIC_POINT_OF_INTEREST"
        ]
      },
      "ChargerType": {
        "type": "string",
        "enum": [
          "TYPE_2_AC",
          "CCS_COMBO_2_DC",
          "CHADEMO_DC",
          "TESLA_SUPERCHARGER"
        ]
      },
      "LocationRequest": {
        "type": "object",
        "required": [
          "name",
          "latitude",
          "longitude",
          "address",
          "city",
          "country",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "minimum": -180,
            "maximum": 180
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "zipCode": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/LocationType"
          }
        }
      },
      "ParkingSpaceRequest": {
        "type": "object",
        "required": [
          "location",
          "totalSpaces",
          "availableSpaces",
          "isHandicapAccessible",
          "isCovered"
        ],
        "properties": {
          "location": {
            "$ref": "#/components/schemas/LocationRequest"
          },
          "totalSpaces": {
            "type": "integer",
            "minimum": 0
          },
          "availableSpaces": {
            "type": "integer",
            "minimum": 0
          },
          "hourlyRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxDurationHours": {
            "type": "integer",
            "nullable": true
          },
          "isHandicapAccessible": {
            "type": "boolean"
          },
          "isCovered": {
            "type": "boolean"
          }
        }
      },
      "EvChargingStationRequest": {
        "type": "object",
        "required": [
          "location",
          "chargerType",
          "numChargers",
          "chargingSpeedKw",
          "isFastCharging",
          "isOperational"
        ],
        "properties": {
          "location": {
            "$ref": "#/components/schemas/LocationRequest"
          },
          "chargerType": {
            "$ref": "#/components/schemas/ChargerType"
          },
          "numChargers": {
            "type": "integer",
            "minimum": 0
          },
          "chargingSpeedKw": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "isFastCharging": {
            "type": "boolean"
          },
          "costPerKwh": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "isOperational": {
            "type": "boolean"
          }
        }
      },
      "LocationResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "latitude",
          "longitude",
          "address",
          "city",
          "country",
          "type",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "zipCode": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/LocationType"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ParkingSpaceResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "latitude",
          "longitude",
          "address",
          "city",
          "country",
          "totalSpaces",
          "availableSpaces",
          "isHandicapAccessible",
          "isCovered",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "zipCode": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string"
          },
          "totalSpaces": {
            "type": "integer"
          },
          "availableSpaces": {
            "type": "integer"
          },
          "hourlyRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxDurationHours": {
            "type": "integer",
            "nullable": true
          },
          "isHandicapAccessible": {
            "type": "boolean"
          },
          "isCovered": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EvChargingStationResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "latitude",
          "longitude",
          "address",
          "city",
          "country",
          "chargerType",
          "numChargers",
          "chargingSpeedKw",
          "isFastCharging",
          "isOperational",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "zipCode": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string"
          },
          "chargerType": {
            "$ref": "#/components/schemas/ChargerType"
          },
          "numChargers": {
            "type": "integer"
          },
          "chargingSpeedKw": {
            "type": "number",
            "format": "double"
          },
          "isFastCharging": {
            "type": "boolean"
          },
          "costPerKwh": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "isOperational": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LocationUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "minimum": -180,
            "maximum": 180
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "zipCode": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/LocationType"
          }
        }
      },
      "ParkingSpaceUpdateRequest": {
        "type": "object",
        "properties": {
          "location": {
            "$ref": "#/components/schemas/LocationUpdateRequest"
          },
          "totalSpaces": {
            "type": "integer",
            "minimum": 0
          },
          "availableSpaces": {
            "type": "integer",
            "minimum": 0
          },
          "hourlyRate": {
            "type": "number",
            "format": "double"
          },
          "maxDurationHours": {
            "type": "integer"
          },
          "isHandicapAccessible": {
            "type": "boolean"
          },
          "isCovered": {
            "type": "boolean"
          }
        }
      },
      "EvChargingStationUpdateRequest": {
        "type": "object",
        "properties": {
          "location": {
            "$ref": "#/components/schemas/LocationUpdateRequest"
          },
          "chargerType": {
            "$ref": "#/components/schemas/ChargerType"
          },
          "numChargers": {
            "type": "integer",
            "minimum": 0
          },
          "chargingSpeedKw": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "isFastCharging": {
            "type": "boolean"
          },
          "costPerKwh": {
            "type": "number",
            "format": "double"
          },
          "isOperational": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
